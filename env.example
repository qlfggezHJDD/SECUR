# Copy this file to .env for local development and fill in a real token.
# .env is gitignored — never commit your real token.
# On Railway, set DISCORD_TOKEN as a Variable in the service settings instead
# of using this file.

DISCORD_TOKEN=your-bot-token-here

# Optional, Railway sets this automatically. Only needed locally if you
# want to test the health-check endpoint on a specific port.
PORT=8080
